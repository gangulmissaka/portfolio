# ─── Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables ───

# Public URL of the site (no trailing slash). Used for auth callbacks, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Database — Neon Postgres connection string. Leave empty locally to use the built-in embedded database (.data/pglite).
DATABASE_URL=

# Your sign-in email(s): unlocks /admin. Comma-separated.
ADMIN_EMAILS=

# Google sign-in — console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
#   Authorised redirect URI: <site url>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in (optional) — github.com/settings/developers → New OAuth App
#   Callback URL: <site url>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Contact form email (optional) — resend.com. Without it, messages still land in /admin.
RESEND_API_KEY=
CONTACT_FROM="Portfolio <hello@your-domain.dev>"
CONTACT_TO=missakabro@gmail.com
CONTACT_AUTOREPLY=0

# Bot protection on the contact form (optional) — Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# Guestbook: starting value for "approve notes first" (afterwards use the switch in Admin → Guestbook)
GUESTBOOK_MODERATION=0

# Optional: raises the GitHub API rate limit for the "Right now" strip
GITHUB_TOKEN=

# Embedded dev database: in memory by default. Uncomment to keep data between restarts
# (stop the dev server with Ctrl+C, not by killing it).
# PGLITE_DIR=./.data/pglite
